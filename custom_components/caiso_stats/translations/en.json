      "forecast_peak_demand_tomorrow": { "name": "Forecast peak demand tomorrow" },
      "current_reserve": { "name": "Operating reserve" },
      "required_reserve": { "name": "Required reserve" },
      "available_capacity": { "name": "Available capacity" },

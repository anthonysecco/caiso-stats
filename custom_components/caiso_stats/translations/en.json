{
  "config": {
    "step": {
      "user": {
        "title": "CAISO Stats",
        "description": "Adds California ISO grid conditions (status, demand, reserves, supply mix, CO2) and a carbon intensity index. Uses CAISO's free public Today's Outlook feeds; no account or key needed. Polls every 15 minutes by default."
      }
    },
    "error": {
      "cannot_connect": "Could not reach CAISO's stats feed. Check the internet connection and try again."
    },
    "abort": {
      "single_instance_allowed": "CAISO Stats is already configured. Change its settings under Configure."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "CAISO Stats options",
        "description": "Polling interval and the Carbon Intensity Index settings.",
        "data": {
          "scan_interval": "Update interval",
          "low_carbon_index_threshold": "Low carbon index threshold",
          "index_days": "Carbon Intensity Index window"
        },
        "data_description": {
          "scan_interval": "How often to poll CAISO (5-60 minutes). Live stats are fetched every poll; the net demand forecast about once an hour.",
          "low_carbon_index_threshold": "Low Carbon Energy Now is on when the Carbon Intensity Index is at or below this (0 = the cleanest hour of recent days, 100 = the dirtiest).",
          "index_days": "Days of history (7-30) whose cleanest and dirtiest hour set the Carbon Intensity Index's 0 and 100."
        }
      }
    }
  },
  "entity": {
    "binary_sensor": {
      "clean_energy_now": { "name": "Low Carbon Energy Now" }
    },
    "sensor": {
